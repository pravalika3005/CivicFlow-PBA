# Optional settings. Copy this file to ".env" (same folder) to change them.
# Nothing here is secret, and the defaults work without this file.

# Database. SQLite file by default. For another database use its URL here.
CIVICFLOW_DATABASE_URL=sqlite:///./civicflow.db

# Where uploaded photos and videos are stored.
CIVICFLOW_UPLOAD_DIR=uploads

# Upload size limits in megabytes.
CIVICFLOW_MAX_VIDEO_MB=100
CIVICFLOW_MAX_IMAGE_MB=5

# Websites allowed to call the API (comma separated).
CIVICFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
